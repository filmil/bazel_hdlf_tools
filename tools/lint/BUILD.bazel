load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

# The hermeticity lint (spec: "A lint test scans all .bzl and BUILD.bazel
# files for the forbidden flags and tags").
#
# A module runs it through hermetic_lint (defs.bzl), a `bazel run` target
# that scans the module's whole tree, its integration module included. No
# test can take a separate module's files as inputs, so the scan is not a
# test; the module's CI runs it on every pull request.
#
# The test below checks the scanner on known-bad and known-good fixtures.

go_library(
    name = "lint_lib",
    srcs = ["lint.go"],
    importpath = "github.com/filmil/bazel_hdlf_tools/tools/lint",
    visibility = ["//visibility:private"],
)

go_test(
    name = "lint_test",
    size = "small",
    srcs = ["lint_test.go"],
    data = glob(["testdata/**"]),
    embed = [":lint_lib"],
    pure = "on",
)

go_binary(
    name = "lint",
    srcs = ["cmd/main.go"],
    pure = "on",
    visibility = ["//visibility:public"],
    deps = [":lint_lib"],
)

exports_files(["defs.bzl"])
